# Pebbles Environment Configuration
# Copy this file to .env and configure values for your environment.

# -----------------------------------------------------------------------------
# Runtime Mode & Governance
# -----------------------------------------------------------------------------
# Authorization provider mode: 'armoriq' (genuine ArmorIQ enforcement) or 'local_policy' (explicit local development policy)
# In production, ARMORIQ_MODE=armoriq is required. If ArmorIQ credentials are missing or invalid, protected operations FAIL CLOSED.
ARMORIQ_MODE=local_policy

# ArmorIQ Platform Credentials (Get from https://app.armoriq.ai / Flow State dashboard)
# Required when ARMORIQ_MODE=armoriq
ARMORIQ_API_KEY=ak_live_your_armoriq_api_key_here
ARMORIQ_USER_EMAIL=developer@example.com
ARMORIQ_POLICY_SCOPE=pebbles-workspace-sandbox
ARMORIQ_BASE_URL=https://api.armoriq.ai

# -----------------------------------------------------------------------------
# Agent LLM Provider Configuration
# -----------------------------------------------------------------------------
# LLM Provider: 'google' (Gemini), 'anthropic' (Claude), 'openai' (GPT-4o), or 'mock' (Deterministic testing agent)
LLM_PROVIDER=mock
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-pro

# -----------------------------------------------------------------------------
# Sandboxed Workspace Configuration
# -----------------------------------------------------------------------------
# Absolute path or relative path to the designated sandbox repository that Builder and Research Pebbles can access.
# Paths outside this sandbox will be strictly rejected.
WORKSPACE_SANDBOX_PATH=./workspace-sandbox/sample-repo
WORKSPACE_MAX_FILE_SIZE_BYTES=1048576

# Allowed test commands in sandbox (comma-separated commands allowed to run via workspace.run_tests)
PERMITTED_TEST_COMMANDS=npm test,pytest,cargo test,node --test

# -----------------------------------------------------------------------------
# Server & Port Configuration
# -----------------------------------------------------------------------------
BACKEND_PORT=3001
FRONTEND_PORT=5173
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
